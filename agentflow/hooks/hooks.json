{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^agentflow:",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/result-check.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
