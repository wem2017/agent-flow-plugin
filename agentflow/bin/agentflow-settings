#!/usr/bin/env python3
"""Edit the repo's .claude/settings.local.json without ever showing secret values (stdlib only).

The guard hook forbids Read/Edit/Write on that file so tokens never enter the transcript; this
tool is the sanctioned way to change it. Always merges — existing keys are kept. The file is
written with mode 600. Worktrees share the settings of the main checkout.

  show                         key tree; values under `env` and secret-looking keys are masked
  set <dotted.key> <json>      e.g. set enabledPlugins.agentflow@agent-flow-plugins true
  set-secret <ENV_NAME>        value read from stdin into env.<ENV_NAME> (never echoed)
  has <ENV_NAME>               exit 0 if env.<ENV_NAME> is set and non-empty
"""

import json
import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts"))
import afconfig  # noqa: E402


SECRET_KEY = re.compile(r"token|secret|password|passwd|api.?key|private.?key|authorization", re.I)


def path():
    return afconfig.settings_path()


def load():
    try:
        with open(path(), encoding="utf-8") as fh:
            return json.load(fh) or {}
    except FileNotFoundError:
        return {}
    except ValueError as err:
        sys.exit("agentflow-settings: %s không phải JSON hợp lệ (dòng %d) — sửa tay rồi chạy lại" % (path(), err.lineno))


def save(data):
    p = path()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    os.replace(tmp, p)


def masked(node, hide=False):
    if isinstance(node, dict):
        return {k: masked(v, hide or k == "env" or bool(SECRET_KEY.search(k))) for k, v in node.items()}
    if isinstance(node, list):
        return [masked(v, hide) for v in node]
    if hide:
        return "<set>" if node else "<empty>"
    return node


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return
    data = load()
    if args[0] == "show":
        print(json.dumps(masked(data), ensure_ascii=False, indent=2))
    elif args[0] == "set" and len(args) == 3:
        if args[1].split(".")[0] == "env":
            sys.exit("agentflow-settings: dùng set-secret cho key trong env")
        if afconfig.settings_key_locked(args[1], args[2]):
            sys.exit("agentflow-settings: %s có thể tắt hook hoặc plugin — người sửa tay nếu thật sự cần" % args[1])
        cur, parts = data, args[1].split(".")
        # plugin ids contain '.'-free names but '@' — split only on '.'
        for key in parts[:-1]:
            cur = cur.setdefault(key, {})
            if not isinstance(cur, dict):
                sys.exit("agentflow-settings: %s không phải object" % key)
        try:
            cur[parts[-1]] = json.loads(args[2])
        except ValueError:
            cur[parts[-1]] = args[2]
        save(data)
        print("set %s" % args[1])
    elif args[0] == "set-secret" and len(args) == 2:
        value = sys.stdin.readline().strip()
        if not value:
            sys.exit("agentflow-settings: stdin rỗng — không ghi")
        data.setdefault("env", {})[args[1]] = value
        save(data)
        print("set env.%s (ẩn)" % args[1])
    elif args[0] == "has" and len(args) == 2:
        sys.exit(0 if (data.get("env") or {}).get(args[1]) else 1)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
